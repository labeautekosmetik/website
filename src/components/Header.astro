---
import Logo from './Logo.astro';
import BookButton from './BookButton.astro';
import { nav } from '../data/site';
import { u } from '../lib/url';

const current = Astro.url.pathname;
---

<header class="header">
  <div class="container header__inner">
    <a href={u()} class="header__home" aria-label="La Beauté Kosmetik – Startseite"><Logo /></a>
    <nav class="header__nav" id="hauptmenue" aria-label="Hauptmenü">
      <ul>
        {
          nav.map((n) => (
            <li>
              <a href={u(n.href)} aria-current={current.startsWith(u(n.href)) ? 'page' : undefined}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="header__cta"><BookButton size="small" /></div>
    <button class="header__toggle" type="button" aria-expanded="false" aria-controls="hauptmenue" aria-label="Menü öffnen">
      <svg class="icon-open" width="26" height="26" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
      <svg class="icon-close" width="26" height="26" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
    </button>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.header__toggle');
  const header = document.querySelector<HTMLElement>('.header');
  const setOpen = (open: boolean) => {
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
    header?.classList.toggle('is-open', open);
  };
  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header?.classList.contains('is-open')) {
      setOpen(false);
      btn?.focus();
    }
  });
  document.addEventListener('pointerdown', (e) => {
    if (header?.classList.contains('is-open') && !header.contains(e.target as Node)) setOpen(false);
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 72px;
  }
  .header__home {
    text-decoration: none;
    margin-right: auto;
  }
  .header__nav ul {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .header__nav a {
    text-decoration: none;
    font-size: 0.95rem;
    padding-block: 0.4rem;
    border-bottom: 1.5px solid transparent;
  }
  .header__nav a:hover,
  .header__nav a[aria-current='page'] {
    border-color: var(--accent);
  }
  .header__toggle {
    display: none;
    width: 48px;
    height: 48px;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .icon-close,
  .header.is-open .icon-open {
    display: none;
  }
  .header.is-open .icon-close {
    display: block;
  }
  @media (max-width: 767px) {
    .header__cta {
      display: none;
    }
  }
  @media (max-width: 920px) {
    .header__toggle {
      display: grid;
      place-items: center;
    }
    .header__home {
      margin-right: auto;
    }
    .header__nav {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow);
    }
    .header.is-open .header__nav {
      display: block;
    }
    .header__nav ul {
      flex-direction: column;
      gap: 0;
      padding: 0.5rem 1.25rem 1rem;
    }
    .header__nav a {
      display: block;
      padding: 0.85rem 0;
      font-size: 1.1rem;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
