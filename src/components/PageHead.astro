---
import { u } from '../lib/url';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs?: { name: string; path: string }[];
}
const { eyebrow, title, lead, crumbs = [] } = Astro.props;
---

<section class="phead">
  <div class="container">
    {
      crumbs.length > 0 && (
        <nav aria-label="Brotkrumen" class="crumbs">
          <a href={u()}>Start</a>
          {crumbs.map((c, i) =>
            i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={u(c.path)}>{c.name}</a>,
          )}
        </nav>
      )
    }
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1 set:html={title} />
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .phead {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 4vw, 2.5rem);
  }
  .phead h1 {
    max-width: 20ch;
  }
  .phead .lead {
    max-width: 60ch;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }
  .crumbs > * + *::before {
    content: '/';
    margin-right: 0.5rem;
    color: var(--line);
  }
  .crumbs a {
    text-decoration: none;
    padding-block: 0.5rem;
  }
  @media (max-width: 600px) {
    .crumbs [aria-current='page'] {
      display: none;
    }
  }
</style>
