---
// Always-visible actions on phones: book, WhatsApp, call.
import { site, whatsappLink } from '../data/site';

interface Props {
  primary?: { label: string; href: string };
}
const { primary } = Astro.props;
---

<nav class="actionbar" aria-label="Schnellkontakt">
  {
    primary ? (
      <a href={primary.href} target="_blank" rel="noopener" class="actionbar__main">{primary.label}</a>
    ) : (
      <a href={site.treatwell} target="_blank" rel="noopener" data-book class="actionbar__main">Termin buchen</a>
    )
  }
  <a href={whatsappLink()} target="_blank" rel="noopener">
    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.3-.4.8-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.4.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"></path></svg>
    WhatsApp
  </a>
  <a href={`tel:${site.phone.replace(/\s/g, '')}`}>
    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" d="M6.6 3h3l1.5 4-2 1.3a11 11 0 0 0 6.6 6.6l1.3-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.6 5.2 2 2 0 0 1 6.6 3Z"></path></svg>
    Anrufen
  </a>
</nav>

<style>
  .actionbar {
    display: none;
  }
  @media (max-width: 767px) {
    .actionbar {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 30;
      background: var(--surface);
      border-top: 1px solid var(--line);
      padding-bottom: env(safe-area-inset-bottom);
    }
    .actionbar a {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      min-height: 60px;
      font-size: 0.85rem;
      font-weight: 500;
      text-decoration: none;
    }
    .actionbar__main {
      background: var(--cta);
      color: var(--cta-text);
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }
  }
</style>
