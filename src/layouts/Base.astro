---
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ActionBar from '../components/ActionBar.astro';
import BookingDialog from '../components/BookingDialog.astro';
import { site } from '../data/site';
import { businessSchema } from '../lib/schema';
import { isPreview, theme, u } from '../lib/url';

interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: object[];
  noindex?: boolean;
  actionBar?: { label: string; href: string };
}

const { title, description, image = '/images/studio-raum.jpg', schema = [], noindex = false, actionBar } = Astro.props;
// Canonical always points at the live domain, without the preview prefix.
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const canonical = new URL(path, site.url).toString();
const fullTitle = title.includes('La Beauté') ? title : `${title} | ${site.name}`;
const jsonLd = [businessSchema(), ...schema];
---

<!doctype html>
<html lang="de" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(isPreview || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={theme === 'c2' ? '#ffffff' : '#f8f4ef'} />
    <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, site.url).toString()} />
    <link rel="alternate" type="text/plain" href={u('llms.txt')} title="Zusammenfassung für KI-Assistenten" />
    {jsonLd.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <Header />
    <main id="inhalt">
      <slot />
    </main>
    <Footer />
    <ActionBar primary={actionBar} />
    <BookingDialog />
  </body>
</html>
