---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import BookButton from '../components/BookButton.astro';
import { u } from '../lib/url';
---

<Base title="Seite nicht gefunden" description="Diese Seite gibt es leider nicht." noindex>
  <PageHead eyebrow="404" title="Diese Seite gibt es leider <em>nicht</em>" lead="Vielleicht hilft dir einer dieser Links weiter:">
    <div class="btn-row">
      <a class="btn btn--ghost" href={u()}>Startseite</a>
      <a class="btn btn--ghost" href={u('behandlungen/')}>Behandlungen</a>
      <BookButton />
    </div>
  </PageHead>
  <div class="section"></div>
</Base>
