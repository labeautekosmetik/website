---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import TreatmentList from '../../components/TreatmentList.astro';
import BookButton from '../../components/BookButton.astro';
import Photo from '../../components/Photo.astro';
import Faq from '../../components/Faq.astro';
import Reviews from '../../components/Reviews.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { categories, euro, greenPeelLevels, itemsFor, type Category } from '../../data/treatments';
import treatwell from '../../data/treatwell.json';
import { u } from '../../lib/url';
import { site, whatsappLink } from '../../data/site';
import { breadcrumbSchema, faqSchema } from '../../lib/schema';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug }, props: { category: c } }));
}

const { category: c } = Astro.props as { category: Category };
const articles = (await getCollection('magazin')).filter((a) => a.data.treatment === c.slug);
const allItems = treatwell.groups.flatMap((g) => g.items);
const levels =
  c.slug === 'green-peel'
    ? greenPeelLevels.map((l) => ({ ...l, price: allItems.find((i) => i.id === l.id)?.priceFrom ?? null }))
    : [];
---

<Base
  title={c.seoTitle}
  description={c.seoDescription}
  image={c.image}
  schema={[
    faqSchema(c.faq),
    breadcrumbSchema([
      { name: 'Start', path: '/' },
      { name: 'Behandlungen', path: '/behandlungen/' },
      { name: c.title, path: `/behandlungen/${c.slug}/` },
    ]),
  ]}
>
  <PageHead
    eyebrow="Behandlung in Bochum"
    title={c.title}
    crumbs={[
      { name: 'Behandlungen', path: 'behandlungen/' },
      { name: c.title, path: `behandlungen/${c.slug}/` },
    ]}
  />

  <section class="container intro">
    <div>
      {c.intro.map((p) => <p class="intro__p">{p}</p>)}
      <h2 class="intro__h">Ideal für</h2>
      <ul class="chip-list">{c.idealFor.map((i) => <li>{i}</li>)}</ul>
      {
        c.hint && (
          <p class="hint">
            {c.hint.text}
            {c.hint.link && (
              <>
                {' '}
                <a href={u(`behandlungen/${c.hint.link.slug}/`)}>{c.hint.link.label} →</a>
              </>
            )}
          </p>
        )
      }
      <div class="btn-row">
        <BookButton />
        <a class="btn btn--ghost" href={whatsappLink(`Hallo Florentine, ich habe eine Frage zu ${c.title}:`)} target="_blank" rel="noopener">Frage per WhatsApp</a>
      </div>
    </div>
    <div class="intro__img"><Photo src={c.image} alt={c.imageAlt} /></div>
  </section>

  <section class="section" aria-labelledby="preise">
    <div class="narrow">
      <h2 id="preise">Behandlungen & <em>Preise</em></h2>
      <p class="lead">Als Neukundin bekommst du {site.newClientOffer}.</p>
      {
        levels.length > 0 && (
          <div class="compare" role="region" aria-label="Green Peel Stufen im Vergleich" tabindex="0">
            <table>
              <thead>
                <tr>
                  <th scope="col">Stufe</th>
                  <th scope="col">Ideal bei</th>
                  <th scope="col">Schälung</th>
                  <th scope="col">Termine</th>
                  <th scope="col">Preis</th>
                </tr>
              </thead>
              <tbody>
                {levels.map((l) => (
                  <tr>
                    <th scope="row">{l.name}</th>
                    <td>{l.idealFor}</td>
                    <td>{l.peeling}</td>
                    <td>{l.sessions}</td>
                    <td class="compare__price">{euro(l.price)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
      <TreatmentList items={itemsFor(c)} stepsLabel={c.slug === 'green-peel' ? 'Ideal bei' : 'Ablauf'} />
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="faq">
    <div class="narrow">
      <h2 id="faq">Häufige <em>Fragen</em></h2>
      <Faq items={c.faq} />
    </div>
  </section>

  {
    articles.length > 0 && (
      <section class="section" aria-labelledby="mag">
        <div class="container">
          <h2 id="mag">Mehr dazu im <em>Magazin</em></h2>
          <div class="grid grid--3">
            {articles.map((a) => (
              <ArticleCard entry={a} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section section--tint">
    <div class="container">
      <h2>Das sagen meine <em>Kundinnen</em></h2>
      <Reviews prefer={c.reviewKeywords} />
    </div>
  </section>
</Base>

<style>
  .intro {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 900px) {
    .intro {
      grid-template-columns: 1.2fr 1fr;
      gap: 4rem;
    }
  }
  .intro__p {
    font-size: 1.1rem;
  }
  .intro__h {
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 500;
    margin: 2rem 0 0.9rem;
  }
  .hint {
    margin-top: 1.25rem;
    padding: 1rem 1.25rem;
    background: var(--surface);
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: 0.95rem;
  }
  .hint a {
    font-weight: 500;
    white-space: nowrap;
  }
  .compare {
    overflow-x: auto;
    margin-bottom: 1.5rem;
    background: var(--surface);
    border-radius: var(--radius);
  }
  .compare table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  .compare th,
  .compare td {
    text-align: left;
    vertical-align: top;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--line);
  }
  .compare thead th {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--muted);
  }
  .compare tbody th {
    font-weight: 500;
    white-space: nowrap;
  }
  .compare__price {
    font-weight: 500;
    white-space: nowrap;
  }
  .intro__img {
    max-width: 420px;
    width: 100%;
    justify-self: center;
  }
  @media (max-width: 899px) {
    .intro__img {
      max-width: 300px;
    }
  }
</style>
